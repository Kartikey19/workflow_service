}
{$DOMAIN} {
 encode zstd gzip
 # Metrics remain reachable only inside the deployment network.
 @private path /metrics
 respond @private 404
 header Strict-Transport-Security "max-age=31536000"
 reverse_proxy api_blue:8080 api_green:8080 {
  health_uri /readyz
  health_interval 5s
  health_timeout 3s
  fail_duration 10s
  max_fails 1
  lb_try_duration 5s
  lb_retry_match {
   method GET HEAD
  }
  flush_interval -1
  stream_close_delay 5m
 }
}
