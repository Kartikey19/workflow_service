# Copy to deploy/.env, chmod 600, and replace values (or run bootstrap.sh).
DOMAIN=workflow.example.com
ACME_EMAIL=operator@example.com
WORKFLOW_IMAGE=ghcr.io/your-owner/workflow_service:main
POSTGRES_USER=workflow
POSTGRES_DB=workflow
POSTGRES_PASSWORD=replace-with-random-hex
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_PASSWORD='replace-with-at-least-12-characters'
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=1
VAULT_OLD_KEYS=
DB_MAX_CONNS=8
WORKER_CONCURRENCY=16
WORKER_BATCH_SIZE=4
SHUTDOWN_GRACE=30s
# Optional platform LLM and workflow assistant; tenant providers also work.
ANTHROPIC_API_KEY=
ASSISTANT_PROVIDER=openrouter
ASSISTANT_API_KEY=
ASSISTANT_MODEL=z-ai/glm-5.3-flash
LLM_PRICING_JSON=
# Optional S3-compatible backups; enable the backups Compose profile.
BACKUP_BUCKET=
BACKUP_PREFIX=workflow/backups/
BACKUP_RETENTION_DAYS=14
BACKUP_SSE=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
# Optional Grafana Cloud; enable the observability Compose profile.
GRAFANA_METRICS_URL=
GRAFANA_METRICS_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_TOKEN=
