{
  "spec_hash": "sha256:ea76569c747263fe4e4e2d219c0d103ff2b450651b6b009085927e6cc308ea08",
  "warnings": [],
  "spec": {
    "api_version": "workflow/v1",
    "name": "sleep-wait",
    "inputs": {
      "order_id": {
        "type": "string",
        "required": true,
        "default": null,
        "enum": null,
        "format": "",
        "minimum": null,
        "maximum": null,
        "pattern": ""
      }
    },
    "timeout_ns": 2592000000000000,
    "nodes": [
      {
        "id": "await_pickup",
        "type": "wait_event",
        "needs": [
          "nap"
        ],
        "join": "all",
        "config": {
          "key": "order.picked_up:${input.order_id}",
          "timeout": "45m"
        },
        "retry": {
          "max_attempts": 1,
          "backoff": "exponential",
          "initial_ns": 1000000000,
          "max_ns": 60000000000,
          "jitter": 0
        },
        "on_timeout": "reassign"
      },
      {
        "id": "nap",
        "type": "sleep",
        "needs": [],
        "join": "all",
        "config": {
          "duration": "10m"
        },
        "retry": {
          "max_attempts": 1,
          "backoff": "exponential",
          "initial_ns": 1000000000,
          "max_ns": 60000000000,
          "jitter": 0
        }
      },
      {
        "id": "notify",
        "type": "transform",
        "needs": [
          "await_pickup"
        ],
        "join": "all",
        "config": {
          "value": "${nodes.await_pickup.output}"
        },
        "retry": {
          "max_attempts": 1,
          "backoff": "exponential",
          "initial_ns": 1000000000,
          "max_ns": 60000000000,
          "jitter": 0
        }
      },
      {
        "id": "reassign",
        "type": "noop",
        "needs": [
          "await_pickup"
        ],
        "join": "any",
        "config": {},
        "retry": {
          "max_attempts": 1,
          "backoff": "exponential",
          "initial_ns": 1000000000,
          "max_ns": 60000000000,
          "jitter": 0
        }
      }
    ],
    "edges": {
      "await_pickup": [
        "notify",
        "reassign"
      ],
      "nap": [
        "await_pickup"
      ],
      "notify": [],
      "reassign": []
    },
    "reverse_edges": {
      "await_pickup": [
        "nap"
      ],
      "nap": [],
      "notify": [
        "await_pickup"
      ],
      "reassign": [
        "await_pickup"
      ]
    },
    "roots": [
      "nap"
    ],
    "topo_order": [
      "nap",
      "await_pickup",
      "notify",
      "reassign"
    ]
  }
