# For local Go development. Production secrets live in App Platform.
DATABASE_URL=postgres://workflow:change-me@127.0.0.1:5432/workflow?sslmode=disable
APP_ENV=development
API_RUNS_WORKER=false
MIGRATE_ON_START=false
HTTP_ADDRESS=:8080
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
# Generate once: openssl rand -base64 32. Preserve keys with database backups.
VAULT_MASTER_KEY=
VAULT_KEY_VERSION=1
VAULT_OLD_KEYS=
ANTHROPIC_API_KEY=
ASSISTANT_PROVIDER=openrouter
ASSISTANT_API_KEY=
ASSISTANT_MODEL=z-ai/glm-5.3-flash
# Non-Anthropic prices are configured explicitly; unknown prices stay unknown.
LLM_PRICING_JSON=
# Register OAuth apps with /be/v1/oauth/callback as their redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
